      "description": "카카오 OAuth 클라이언트 시크릿"
    },
    {
      "name": "oauth2.naver.client-id",
      "type": "java.lang.String",
      "description": "네이버 OAuth 클라이언트 ID"
    },
    {
      "name": "oauth2.naver.client-secret",
      "type": "java.lang.String",
      "description": "네이버 OAuth 클라이언트 시크릿"
    },
    {
      "name": "oauth2.google.client-id",
      "type": "java.lang.String",
      "description": "구글 OAuth 클라이언트 ID"
    },
    {
      "name": "oauth2.google.client-secret",
      "type": "java.lang.String",
      "description": "구글 OAuth 클라이언트 시크릿"
    },
    {
      "name": "app.meeting.invite.base-url",
      "type": "java.lang.String",
